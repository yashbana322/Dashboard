{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd transport-broker/frontend && npm install && npm run build",
  "outputDirectory": "transport-broker/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
